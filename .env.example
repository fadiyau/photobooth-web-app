# ==========================================
# SUPABASE (Database & Authentication)
# ==========================================
# URL proyek Supabase (Contoh: https://xyz.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=""

# Anon Key (Untuk akses publik / frontend)
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Service Role Key (Untuk bypass RLS di backend/server - RAHASIA)
SUPABASE_SERVICE_ROLE_KEY=""

# ==========================================
# CLOUDFLARE R2 (Image Storage)
# ==========================================
# ID Akun Cloudflare
CLOUDFLARE_R2_ACCOUNT_ID=""

# Access Key R2
CLOUDFLARE_R2_ACCESS_KEY_ID=""

# Secret Key R2 (RAHASIA)
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""

# Nama Bucket untuk menyimpan frame dan hasil foto
CLOUDFLARE_R2_BUCKET_NAME=""

# Public URL (Jika R2 diakses menggunakan custom domain/CDN)
CLOUDFLARE_R2_PUBLIC_URL=""